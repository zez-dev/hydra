{
  "name": "@deepseek-ai/dsh-goal-supervisor",
  "description": "Resumes stored sessions with active goals at boot under a concurrency cap and a daily round budget, and the /goals command",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
